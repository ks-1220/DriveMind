{
  "framework": null,
  "buildCommand": "echo Static build complete",
  "outputDirectory": "frontend",
  "rewrites": [
    {
      "source": "/api/fleet",
      "destination": "/static_data/fleet.json"
    },
    {
      "source": "/api/graph",
      "destination": "/static_data/graph.json"
    },
    {
      "source": "/api/data-source",
      "destination": "/static_data/data_source.json"
    }
  ],
  "headers": [
    {
      "source": "/static_data/(.*)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/(.*).css",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/css"
        }
      ]
    },
    {
      "source": "/(.*).js",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/javascript"
        }
      ]
    }
  ]
}
